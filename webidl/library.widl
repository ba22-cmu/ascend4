/**
	Handles the loading of ASCEND a4c files into memory, then the
	listing of the contents of those loaded files. Creates output
	when loaded files contain errors, although a standardised
	method for reporting errors is desired for reporting back.
*/
 partial interface Library{

	void Library(DOMString defaultpath);
	// ~Library();

	void load([Const] DOMString filename);
	void loadString([Const] DOMString str, [Const] DOMString nameprefix);
	static DOMString getLoadErrorMessage(long status);

	void listModules([Const] long module_type);
	[Ref] Type findType([Const, Ref] SymChar name_to_find);
	Module_list getModules([Const] long module_type);
	Type_list getModuleTypes([Const, Ref] Module m);

	// External Function library
	StringList getExtMethodNames();

	//static void extMethodTraverse(void *,void *);
	// void appendToExtMethodVector(void *);

	// Destroy types from the library
	void clear();

	AnnotationDatabase getAnnotationDatabase();

	/// get a listing of all units available in the library
	UnitsM_list getUnits() ;
	Type_list getRealAtomTypes() ;

};


