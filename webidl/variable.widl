/**
	This is a wrapper for the var_variable type in ASCEND. This
	type is used in reporting the variables in an instance, including
	when looking for 'eligible' variables which can be fixed.
*/
partial interface Variable{
	void Variable();
	void Variable([Const, Ref] Variable old);
	// void Variable(Simulation sim, var_variable var);

	[Const] DOMString getName() ;
	[Const] double getValue() ;
	[Const] double getNominal() ;
	[Const] double getUpperBound() ;
	[Const] double getLowerBound() ;
	[Const] Relation_list getIncidentRelations() ;
	[Const] long getNumIncidentRelations() ;

	aw_Instance getInstance();
};


