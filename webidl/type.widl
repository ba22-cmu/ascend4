/**
	A model type as loaded from an ASCEND a4c file. For example, a type
	might be a 'test_controller' from the simple_fs.a4l example file.

	Once you have a type, you can create an instance of it (getInstance)
	which will then allow you to start on solving it.
*/
 partial interface Type{
	void Type();
	// void Type([Const] TypeDescription t);
	[Const] SymChar getName() ;
	[Const] long getParameterCount() ;
	// [Const] TypeDescription getInternalType() ;
	// workaround for bug #494:
	Simulation getSimulation([Const, Ref] SymChar name, [Const] boolean rundefaultmethod);
	//Simulation getSimulation([Const] SymChar &name="sim", [Const] boolean &rundefaultmethod=true);
	[Const] Dimensions getDimensions() ;
	Method_list getMethods() ; ///< FIXME this does not report 'built in' methods like reset, ClearAll
	Method getMethod([Const, Ref] SymChar name) ; ///< exception if not found
	[Const] boolean isRefinedSolverVar() ; ///< is this type a refinement of solver_var?
	[Const] boolean isRefinedAtom() ;
	[Const] boolean isRefinedReal() ;
	[Const] boolean isRefinedConstant() ;
	[Const] boolean isFundamental() ;
	[Const] boolean isModel() ;
	[Const] boolean hasParameters() ;
	[Const, Ref] Type findMember([Const, Ref] SymChar name);

	Module getModule() ;

	boolean lt([Const, Ref] Type other) ; // <
};


