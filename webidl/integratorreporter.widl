*//** @file
	C++ wrapper for the IntegratorReporter struct in the solver C-API.
	This interface is intended to be exposed via the SWIG 'director' functionality
	which allows it to be overloaded in Python, so reporting of integration
	results can be done directly with python scripts of the user's design.
*/



/**
	Observer API to allow ASCEND to add rows/columns to the observer panel
	in the Python interface.

	Should also be generalisable so that we can output observations to files
	etc.
*/
 partial interface IntegratorReporterCxx{
	void IntegratorReporterCxx(Integrator i);
	// ~IntegratorReporterCxx();

	//void addObservedVariable(Variable v);
	long initOutput();
	long closeOutput();
	long updateStatus();
	long recordObservedValues();

	Integrator getIntegrator();

};

/**
	NULL integrator reporter. This reporter won't output ANYTHING at all.
*/
 partial interface IntegratorReporterNull /*: IntegratorReporterCxx */ {
	void IntegratorReporterNull(Integrator i);
	// ~IntegratorReporterNull();

	long initOutput();
	long closeOutput();
	long updateStatus();
	long recordObservedValues();
};

/**
	Simple console based integrator reporter. Output the observed variables
	to the console at each sample point.
*/
 partial interface IntegratorReporterConsole /* : IntegratorReporterCxx */ {
	void IntegratorReporterConsole(Integrator i);
	// ~IntegratorReporterConsole();

	long initOutput();
	long closeOutput();
	long updateStatus();
	long recordObservedValues();
};

 partial interface IReporter { // was ascxx_integratorreporter
	static long init(VoidPtr IntegratorSystem_blsys);
	static long write(VoidPtr IntegratorSystem_blsys);
	static long write_obs(VoidPtr IntegratorSystem_blsys);
	static long close(VoidPtr IntegratorSystem_blsys);
};

