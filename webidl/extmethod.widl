
/**
	This is a wrapper for external methods as returned
	by the getExtMethods method of the Library object. At this stage it
	is purely for extracting meta-data about the ExtMethod.
*/
 partial interface ExtMethod {
	void ExtMethod();

	// extMethod(PyObject *);

	void ExtMethod([Const] DOMString name);
	// void ExtMethod([Const] ExternalFunc ef);
	// void ExtMethod([Const, Ref] ExtMethod em);
	[Const] DOMString getHelp() ;
	[Const] DOMString getName() ;
	[Const] unsigned long getNumInputs() ;
	[Const] unsigned long getNumOutputs() ;
};


