*//** @file
	C++ wrapper for the Integrator interface. Intention is that this will allow
	up to use the PyGTK 'observer' tab to receive the results of an integration
	job, which can then be easily exported to a spreadsheet for plotting (or
	we can implement ASCPLOT style plotting, perhaps).
*/



 partial interface Integrator{
	void Integrator([Ref] Simulation s);
	readonly attribute long LSODE;
	readonly attribute long IDA;

	static DOMString[] getEngines();
	void setEngine([Const, Ref] DOMString name);
	DOMString getName() ;

	SolverParameters getParameters() ;
	void setParameters([Const, Ref] SolverParameters sp);

	void setReporter(IntegratorReporterCxx reporter);

	void setMinSubStep(double d);
	void setMaxSubStep(double d);
	void setInitialSubStep(double d);
	void setMaxSubSteps(long mss);

	void setLinearTimesteps(UnitsM units, double start, double end, unsigned long num);
	void setLogTimesteps(UnitsM units, double start, double end, unsigned long num);
	double[] getCurrentObservations();
	void saveObservations();
	double[] getObservationIndex(long i);
	// and goi function in webcxx::Integrator
	// std::vector<std::vector<double> > getObservations();
	Variable getObservedVariable([Const, Ref] long i);
	Variable getIndependentVariable();

	void findIndependentVar(); /**< find the independent variable (must not presume a certain choice of integration engine) */
	void analyse();
	void solve();

	/** write out a named matrix associated with the integrator, if possible. type can be NULL for the default matrix. */
	void writeMatrix(DOMString fname, [Const] DOMString type) ;
	void writeDebug(DOMString fname) ;

	double getCurrentTime();
	long getCurrentStep();
	long getNumSteps();
	long getNumVars();
	long getNumObservedVars();

};
