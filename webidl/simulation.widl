 partial interface SingularityInfo{
	boolean isSingular() ;
	attribute Relation_list rels; /**< relations involved in the singularity */
	attribute Variable_list vars; /**< variables involved in the singularity */
	attribute Variable_list freeablevars; /**< vars that should be freed */
};

enum StructuralStatus{
	"is-dof-underspecified", // 1
	"SS-dof-square", /* = EVERYTHING's ok */
	"SS-dof-overspecified", // =4,
	"SS-dof-struct-singular" //=3
};

/**
	@TODO This interface is for *Simulation* instances.

	Handle instantiating, running initialisation functions, solving
	and outputing results of solutions.

	In ASCEND C-code, a simulation is a special type of Instance. It
	has a 'simulation root' instance which often needs to be used for
	solving, inspecting, etc, rather than the simulation instance itself.

	The Simulation can be exported to an Integrator (for time-stepping)
	or a Solver (for steady-state solutions).

	At present the architecture is a bit muddy wrt to way that Solvers and
	Integrators 'act on' the Simulation. We need to work on improving the
	delimitation of solver and integrator, and keeping better track of the 
	state of the Simulation (has it been 'built', etc).
*/
 partial interface Simulation /* : aw_Instance */ {
	void Simulation(aw_Instance i, [Const, Ref] SymChar name);
	void Simulation([Const, Ref] Simulation s);
	//~Simulation();

	[Ref] aw_Instance getModel();

	void runDefaultMethod();
	void run([Const, Ref] Method method);
	void run([Const, Ref] Method method, [Ref] aw_Instance model);


	// checks on the instance tree
	void checkInstance([Const, Ref] long level);
	void checkTokens();
	void checkStructure();
	void checkStatistics();
	void checkDimensions();

	void build();

	// checks of solver lists/structure
	StructuralStatus checkDoF() ;
	boolean checkStructuralSingularity();
	[Const, Ref] SingularityInfo getSingularityInfo() ;

	void solve(Solver s, [Ref] SolverReporter reporter);
	void presolve(Solver s);
	[Const] long iterate();
	void postsolve(SolverStatus status);
	SolverStatus getStatus();

	Variable_list getFixableVariables();
	Variable_list getVariablesNearBounds([Const, Ref] double epsilon);
	Variable_list getVariablesFarFromNominals([Const, Ref] double bignum);
	Variable_list getFixedVariables();
	Variable_list getallVariables();
	Matrix getMatrix();

	void write([Const] DOMString fname, [Const] DOMString type) ;

	void setSolver([Ref] Solver s);
	[Const] Solver getSolver() ;

	SolverParameters getParameters() ;
	void setParameters([Ref] SolverParameters sp);

	IncidenceMatrix getIncidenceMatrix();

	[Const] DOMString getInstanceName([Const] aw_Instance i) ;

	void processVarStatus();
	[Const] long getNumVars();

	[Const] long getActiveBlock() ;

	Variable_list getFreeableVariables();
	
	void setSolverHooks(SolverHooks H);
	SolverHooks getSolverHooks() ;
};


