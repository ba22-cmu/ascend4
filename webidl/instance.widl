// interface Plot;

enum InstanceStatus {
	"aw-init-status-unknown",
	"aw-var-fised",
	"aw-var-unsolved",
	"aw-var-active",
	"aw-var-solved",
	"aw-rel-inactive"
};

/**
	This interface has to be called 'aw_Instance' in C++ to avoid a name clash
	with C. 
*/
 partial interface aw_Instance{
	void aw_Instance();
	// void aw_Instance(aw_Instance i);
	void aw_Instance(aw_Instance i, [Const, Ref] SymChar name, boolean dummy);
	void aw_Instance([Const, Ref] aw_Instance parent, [Const, Ref] unsigned long childnum);
	void aw_Instance([Const, Ref] aw_Instance i);
	[Ref] aw_Instance_list getChildren();
	aw_Instance getChildS([Const, Ref] SymChar v) ;
	aw_Instance getChildI([Const, Ref] long v) ;
	// [Const] inst_t getKind() ;
	[Const] DOMString getKindStr() ;

	[Const] Type getType() ;
	[Const] boolean isAtom() ;
	[Const] boolean isFixed() ;
	[Const] boolean isIncluded() ;

	[Const] boolean isFund() ;
	[Const] boolean isConst() ;
	[Const] boolean isCompound() ;
	[Const] boolean isRelation() ;
	[Const] boolean isLogicalRelation() ;
	[Const] boolean isWhen() ;
	[Const] boolean isSet() ;
	[Const] boolean isSetInt() ;
	[Const] boolean isSetString() ;
	[Const] boolean isSetEmpty() ; // set of of type 'empty', NB not same as SetInt::length()==0
	[Const] boolean isArray() ;
	[Const] boolean isDefined() ;
	[Const] boolean isChildless() ;
	[Const] boolean isBool() ;
	[Const] boolean isInt() ;
	[Const] boolean isSymbol() ;
	[Const] boolean isReal() ;
	[Const] boolean isAssigned() ;
	[Const] boolean isModel() ;

	[Const, Ref] SymChar getName() ;
	[Const] double getRealValue() ;
	[Const] boolean isDimensionless() ;
	[Const] Dimensions getDimensions() ;
	[Const] boolean getBoolValue() ;
	[Const] long getIntValue() ;
	[Const] SymChar getSymbolValue() ;

	[Const] DOMString getWhenAsString([Const, Ref] aw_Instance relative_to) ;
	[Const] DOMString getLogrelAsString([Const, Ref] aw_Instance relative_to) ;
	[Const] DOMString getValueAsString() ;
	[Const] DOMString getRelationAsString([Const, Ref] aw_Instance relative_to) ;
	Plot getPlot() ;

	[Const] boolean isPlottable() ;

	void setFixed([Const, Ref] boolean val);
	void setIncluded([Const, Ref] boolean val);
	void setBoolValue([Const, Ref] boolean b, [Const, Ref] unsigned long depth);
	void setIntValue([Const, Ref] long v, [Const, Ref] unsigned long depth);
	void setRealValue([Const, Ref] double d, [Const, Ref] unsigned long depth);
	void setRealValueWithUnits(double d, [Const] DOMString s, [Const, Ref] unsigned long depth);
	void setSymbolValue([Const, Ref] SymChar s);

	[Const] long[] getIntegerSetValue();
	[Const] StringList getSymbolSetValue();

	//[Const] set_kind getSetType() ;
	[Const] DOMString getSetType() ;
	void write([Const] DOMString fname) ;
	aw_Instance getInternalType() ;

	void setStatus([Const, Ref] InstanceStatus s); ///< make this one private, just for friend Simulation?
	[Const] InstanceStatus getStatus() ;

	void setLowerBound([Const, Ref] double d);
	void setUpperBound([Const, Ref] double d);
	void setNominal([Const, Ref] double d);
	[Const] double getLowerBound() ;
	[Const] double getUpperBound() ;
	[Const] double getNominal() ;

	[Const] aw_Instance_list getClique() ;
	[Const] StringList getAliases() ;

	[Const] double getResidual() ;
	[Const] boolean getLogicalResidual() ;
};
