 partial interface SolverParameter{
	//void SolverParameter(slv_parameter sp);
	// void SolverParameter &operator=([Const] SolverParameter &);

	[Const] DOMString getName() ;
	[Const] DOMString getDescription() ;
	[Const] DOMString getLabel() ;
	[Const, Ref] long getNumber() ;
	[Const, Ref] long getPage() ;

	[Const] boolean isInt() ;
	[Const] boolean isBool() ;
	[Const] boolean isStr() ;
	[Const] boolean isReal() ;

	// The following throw execeptions unless the parameter type is correct
	[Const, Ref] long getIntValue() ;
	[Const, Ref] long getIntLowerBound() ;
	[Const, Ref] long getIntUpperBound() ;
	void setIntValue([Const, Ref] long v);

	[Const] boolean getBoolValue() ;
	void setBoolValue([Const] boolean b);

	[Const] DOMString getStrValue() ;
	[Const] DOMString[] getStrOptions() ;
	void setStrValue([Const, Ref] DOMString s);
	void setStrOption([Const, Ref] long opt);

	[Const, Ref] double getRealValue() ;
	[Const, Ref] double getRealLowerBound() ;
	[Const, Ref] double getRealUpperBound() ;
	void setRealValue([Const, Ref] double d);

	[Const] boolean isBounded() ;

	[Const] DOMString stringFormat() ;

	void setValueValue([Const, Ref] Value V);
};


