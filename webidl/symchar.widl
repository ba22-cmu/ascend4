/**
	A container for ASCEND strings, used to ensure
	that twe identical strings created via the SymChar interface
	will only be stored once in memory, and can be tested for
	equality using pointer comparison alone.

	 @TODO @bug FIXME There is a problem with the calling conventions of char * and symchar*
	 -- C++ can't tell which one you're trying to use.
*/
 partial interface SymChar{
	void SymChar([Const, Ref ] DOMString name);
	// void SymChar([Const ] DOMString name);
	// void SymChar([Const, Ref ] SymChar s);
	// void SymChar([Const, Ref ] InstanceName n);
	boolean eq([Const, Ref ] SymChar s) ; // ==
	boolean lt([Const, Ref ] SymChar s) ; // <

	[Const ] DOMString stringFormat() ;
	// [Const ] symchar getInternalType() ;
};

