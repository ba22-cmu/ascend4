 partial interface Dimensions{
	readonly attribute unsigned long MAX_DIMS;
	//// readonly attribute FrozenArray<DOMString> BASEUNITS; FIXME: emcc version

	/// Return the string name of fundamental unit for the i-th dimension of measurement.
	static DOMString getBaseUnit([Const] unsigned long i);

	/// Construct a Dimension object fro mthe ASCEND internal data type
	//void Dimensions([Const] dim_type d);

	/// Copy [Const]ructor
	void Dimensions([Const, Ref] Dimensions D);

	/// Default [Const]ructor, required to keep std::vector happy
	void Dimensions();

	/// Return the ASCEND internal datatype
	// [Const] dim_type getInternalType();

	[Const] DOMString stringFormat(); // fixme c++ tostring

	// Comparison operators
	[Const] boolean lt([Const, Ref] Dimensions D);
	[Const] boolean eq([Const, Ref] Dimensions D);
	[Const] boolean ne([Const, Ref] Dimensions D);

	/// Get default units for the given dimension
	// [Const] UnitsM getDefaultUnits(); # DEFINED IN PYTHON

	/// Get the user's preferred units for the given dimension
	//[Const] UnitsM getUserUnits(); # DEFINED IN PYTHON

	/// Test for a dimensionless Dimension object
	[Const] boolean isDimensionless();

	/// Test for a wildcard ('don't care') Dimension object
	[Const] boolean isWild();

	/// Get the numerator part of the index in the i-th dimension (eg for Area, with i={length}, return 2)
	[Const] short getFractionNumerator([Const, Ref] unsigned long i);

	/// Get the denominator part of the index in the i-th dimension
	[Const] short getFractionDenominator([Const, Ref] unsigned long i);
};


