 partial interface Compiler{
	void Compiler();
	static Compiler instance(); /* (as in singleton pattern) */
	static Compiler getCompiler();

	[Const] boolean getUseRelationSharing();
	void setUseRelationSharing([Const, Ref] boolean b);

	void setBinaryCompilation([Const, Ref] boolean b);

	void setVerbosity([Const, Ref] long v);
};

