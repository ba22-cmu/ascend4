	
/// Wrapper interface for slv_parameters_t
 partial interface SolverParameters{

	void SolverParameters();
	void SolverParameters([Const, Ref] SolverParameters sp);

	[Const] DOMString stringFormat() ;

	[Const] long getLength() ; ///< Number of parameters
	SolverParameter getParameterI([Const, Ref] long index) ;
	SolverParameter getParameterN([Const, Ref] DOMString name) ;

	[Const] SolverParameterIterator begin() ;
	[Const] SolverParameterIterator end() ;
};


