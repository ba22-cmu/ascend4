

/**
	Initialisation functions are specified
	in models using "METHOD" statements.

	This interface acts as a holder for these funtions, so that they
	can be passed from a type to an instance via instanc.run(method).

	(@TODO rename this interface to Method or similar)
*/
 partial interface Method{
	// void Method(InitProcedure initproc);
	void Method();
	//void Method([Const, Ref] Method m);
	//~Method();
	// InitProcedure getInternalType();
	[Const] DOMString getName();
	SymChar getSym();
};


