enum IncidencePointType {
	"im-null", // 0
	"im-active-fixed",
	"im-active-free",
	"im-dormant-fixed",
	"im-dormant-free"
};

enum BlockStatusType {
	"im-converged", // 0
	"im-over-iter",
	"im-over-time",
	"im-diverged",
	"im-not-yet-attempteD"
};

 partial interface IncidencePoint{
	void IncidencePoint([Const, Ref] long row, [Const, Ref] long col, [Const, Ref] IncidencePointType type);
	void IncidencePoint([Const, Ref] IncidencePoint ipt);
	void IncidencePoint();

	attribute long row;
	attribute long col;
	attribute IncidencePointType type;
};

/**
	Special interface for plotting incidence matrices using matplotlib

	GOAL: facilitate use of pylab 'spy2' function, but hopefully add extra
	stuff for viewing blocks and fixed/free incidences, solved/active/unsolved
	variables, etc.

	This is going to be like a C++ified copy of MtxProc.c
*/
 partial interface IncidenceMatrix{

	void IncidenceMatrix([Ref] Simulation sim);
	// ~IncidenceMatrix();

	[Const, Ref] IncidencePoint_list getIncidenceData();
	[Const, Ref] long getNumRows() ;
	[Const, Ref] long getNumCols() ;
	[Const] Variable getVariable([Const, Ref] long row) ;
	[Const] Relation getRelation([Const, Ref] long col) ;
	[Const] long getBlockRow([Const, Ref] long row) ;
	[Const] Variable_list getBlockVars([Const, Ref] long block);
	[Const] Relation_list getBlockRels([Const, Ref] long block);
	[Const] long[] getBlockLocation([Const, Ref] long block) ;
	[Const] BlockStatusType getBlockStatus([Const, Ref] long block) ;
	[Const] long getNumBlocks();
};


