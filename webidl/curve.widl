 partial interface Curve /*: aw_Instance */ {
	void Curve(); // hack -- this was previously private. not sure what this breaks.
	void Curve([Const, Ref] Curve c);
	attribute double[] x;
	attribute double[] y;
	[Const] DOMString getLegend();

	/**
		Get the curve format string, as used by matplotlib.
		Documented here:
		http://matplotlib.sourceforge.net/api/axes_api.html#matplotlib.axes.Axes.plot

		(This value is not used by the Tcl/Tk GUI.)
	*/
	[Const] DOMString getFormat();
};


