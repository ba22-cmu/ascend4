/**
	Class to wrap slv_status_t and provide
	and query interface to access various data from it
*/
 partial interface SolverStatus{
	void SolverStatus();
	void SolverStatus([Const, Ref] SolverStatus old);
	void getSimulationStatus([Ref] Simulation s);

	boolean isOK() ;
	boolean isOverDefined() ;
	boolean isUnderDefined() ;
	boolean isStructurallySingular() ;
	boolean isInconsistent() ;
	boolean isReadyToSolve() ;
	boolean isConverged() ;
	boolean isDiverged() ;
	boolean hasExceededIterationLimit() ;
	boolean hasExceededTimeLimit() ;
	boolean hasResidualCalculationErrors() ;
	boolean isInterrupted() ;
	long getIterationNum() ;

	// block structure stuff...

	long getNumBlocks() ;
	long getCurrentBlockNum() ;
	long getCurrentBlockSize() ;
	long getCurrentBlockIteration() ;
	long getNumConverged() ; /* previous total size */
	long getNumJacobianEvals() ;
	long getNumResidualEvals() ;
	double getBlockResidualRMS() ;
};


